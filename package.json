{
  "name": "bounce-defense",
  "private": true,
  "version": "0.1.0",
  "description": "Physics-driven roguelite build-crafting game: your ball is the character.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazimazi/BounceDefense.git"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/ui-engines.mjs",
    "test:ui:layout": "node --import tsx scripts/ui-audit.mjs",
    "test:ui:flow": "node scripts/game-flow.mjs",
    "test:ui:back": "node scripts/back-check.mjs",
    "test:ui:motion": "node scripts/motion-check.mjs",
    "test:watch": "vitest",
    "sim": "tsx scripts/simulate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright-core": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
